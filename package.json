{
  "name": "reelright",
  "version": "1.0.0",
  "description": "Reelright: a native-first Remotion workspace that turns application prototypes into deterministic product demos and scripted product-tour videos.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/da-troll/reelright.git"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.517",
    "@remotion/google-fonts": "4.0.517",
    "@remotion/media": "4.0.517",
    "@remotion/tailwind-v4": "4.0.517",
    "@remotion/zod-types": "4.0.517",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.517",
    "tailwindcss": "4.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.517",
    "@remotion/renderer": "4.0.517",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/web": "0.0.166",
    "css-loader": "7.1.4",
    "eslint": "^9.39.2",
    "globals": "17.11.0",
    "pixelmatch": "7.1.0",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "postcss": "8.5.26",
    "postcss-selector-parser": "7.1.5",
    "prettier": "3.6.0",
    "sass": "1.103.1",
    "sass-loader": "17.0.0",
    "semver": "7.8.5",
    "style-loader": "4.0.0",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "build:rspack": "remotion bundle --rspack",
    "check:clean-clone": "npm run lint && npm run build && npm run build:rspack",
    "app:list": "node scripts/remotion-app.mjs list",
    "app:capture": "node scripts/remotion-app.mjs capture",
    "app:capture:verify": "node scripts/remotion-app.mjs capture-verify",
    "app:fetch": "node scripts/remotion-app.mjs fetch",
    "app:install": "node scripts/remotion-app.mjs install",
    "app:check": "node scripts/remotion-app.mjs check",
    "app:prepare": "node scripts/remotion-app.mjs prepare",
    "app:preflight": "node scripts/remotion-app.mjs preflight",
    "app:studio": "node scripts/remotion-app.mjs studio",
    "app:verify": "node scripts/remotion-app.mjs verify",
    "test:adapter-runtime": "node scripts/test-adapter-runtime.mjs",
    "test:capture-runtime": "node scripts/test-capture-runtime.mjs",
    "test:next-preflight": "node scripts/test-next-playground-preflight.mjs",
    "proof:vite:prepare": "node scripts/prepare-vite-proof.mjs",
    "proof:vite:preflight": "node scripts/preflight-vite-proof.mjs",
    "proof:vite:test-css": "node scripts/test-vite-proof-css-guard.mjs",
    "proof:vite:typecheck": "tsc -p adapters/vite-proof/tsconfig.json",
    "proof:vite:check": "npm run build --prefix input/vite-proof && npm run proof:vite:preflight && npm run proof:vite:test-css && npm run proof:vite:prepare && npm run proof:vite:typecheck",
    "proof:vite:studio": "npm run app:studio -- --app vite-proof",
    "proof:vite:verify": "node scripts/verify-vite-proof.mjs",
    "upgrade": "remotion upgrade",
    "lint": "eslint src adapters adapter-runtime scripts && tsc && npm run proof:vite:typecheck"
  },
  "sideEffects": [
    "*.css"
  ]
}
